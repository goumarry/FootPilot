# ============================================================
#  FootPilot — Variables d'environnement Docker Compose
#  Copier ce fichier en .env et renseigner chaque valeur.
#  NE JAMAIS commiter le fichier .env sur Git.
# ============================================================

# ── Base de données ──────────────────────────────────────────
POSTGRES_DB=footpilot
POSTGRES_USER=footpilot
POSTGRES_PASSWORD=change_me_strong_password

# ── URLs de l'application ────────────────────────────────────
# URL publique du frontend (utilisée dans les liens emails et redirections Stripe)
APP_URL=http://localhost:3000
# Origine autorisée pour les requêtes CORS vers le backend
CORS_ORIGIN=http://localhost:3000
# URL de l'API appelée par le frontend lors du build Vite
VITE_API_URL=http://localhost:3001

# ── Authentification ─────────────────────────────────────────
# Chaîne aléatoire d'au moins 32 caractères (ex: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_string_minimum_32_chars

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID du price Stripe pour l'abonnement mensuel (4,99 €/mois)
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID du price Stripe pour le paiement unique (9,99 €)
STRIPE_PAYMENT_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
